# Application
APP_NAME=CantiereTrack API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://cantieretrack:cantieretrack@db:5432/cantieretrack

# JWT - IMPORTANT: Generate a secure SECRET_KEY for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Security
PASSWORD_MIN_LENGTH=8
REQUIRE_UPPERCASE=True
REQUIRE_DIGIT=True
REQUIRE_SPECIAL_CHAR=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://frontend:3000"]
